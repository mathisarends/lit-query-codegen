{
  "name": "lit-query-codegen",
  "version": "0.1.0",
  "description": "Generate feature-based OpenAPI clients and TanStack Lit Query options with Orval.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathisarends/lit-query-codegen.git"
  },
  "bugs": {
    "url": "https://github.com/mathisarends/lit-query-codegen/issues"
  },
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "lit-query-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime.ts",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.ts",
    "test:package": "node test/package-smoke.ts",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jiti": "2.6.1",
    "orval": "8.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@tanstack/lit-query": "0.2.25",
    "@scalar/openapi-types": "0.9.7",
    "@types/node": "^24.0.0"
  },
  "keywords": [
    "openapi",
    "orval",
    "lit",
    "tanstack-query",
    "codegen"
  ]
}
